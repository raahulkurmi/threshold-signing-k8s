# TEST-ONLY image for e2e network-isolation checks (N1–N3, E8). Never deployed.
FROM golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY test/e2e/probe/ test/e2e/probe/
RUN CGO_ENABLED=0 go build -trimpath -o /out/probe ./test/e2e/probe

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --from=builder /out/probe /usr/local/bin/probe
USER 65534
ENTRYPOINT ["/usr/local/bin/probe"]
